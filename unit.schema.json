{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "English Atelier unit",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "shortTitle": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "integer"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "pdf": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": []
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "body",
          "examples"
        ]
      },
      "minItems": 1
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "example": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "term",
          "definition",
          "example"
        ]
      },
      "minItems": 1
    },
    "exerciseGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "passage": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "choice",
                    "text",
                    "self"
                  ]
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 2,
                  "uniqueItems": true
                },
                "answer": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  ]
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "hint": {
                  "type": "string",
                  "minLength": 1
                },
                "modelAnswer": {
                  "type": "string",
                  "minLength": 1
                },
                "referenceTerms": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "type",
                "prompt",
                "explanation"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "choice"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "options",
                      "answer"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "text"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "answer"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "type": {
                        "const": "self"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "modelAnswer"
                    ]
                  }
                }
              ]
            },
            "minItems": 1
          },
          "wordBank": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "support": {
            "type": "string"
          },
          "passageTitle": {
            "type": "string"
          },
          "sourcePage": {
            "type": "integer"
          },
          "bankRequiresChange": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "instruction",
          "questions"
        ]
      },
      "minItems": 1
    },
    "audio": {
      "type": "object",
      "properties": {
        "track": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggestedTrack": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 2
              },
              "extracts": {
                "type": "integer",
                "minimum": 1
              },
              "answerKey": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                ]
              }
            },
            "required": [
              "id",
              "title",
              "instruction",
              "options",
              "extracts"
            ]
          },
          "minItems": 0
        }
      },
      "required": []
    },
    "label": {
      "type": "string",
      "pattern": "^[0-9]+[ab]?$"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "number",
    "title",
    "shortTitle",
    "description",
    "objectives",
    "lessons",
    "vocabulary",
    "exerciseGroups"
  ]
}
